// M-Pesa Business Manager — Prisma schema
// PostgreSQL via Supabase. Multi-tenant: every record belongs to an Organization.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationTier {
  FREE
  PRO
}

enum MemberRole {
  OWNER
  ADMIN
  STAFF
}

enum SaleStatus {
  COMPLETED
  PENDING
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  MPESA
  CASH
  CARD
  BANK_TRANSFER
  CREDIT
}

enum MpesaDirection {
  INCOMING
  OUTGOING
}

enum MpesaStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
}

enum MpesaEnvironment {
  SANDBOX
  PRODUCTION
}

/// Platform-wide environment isolation for infrastructure resources.
/// Every financial record (payments, ledger entries, payouts, refunds,
/// API keys…) carries an environment; SANDBOX data can never interact with
/// live provider traffic.
enum Environment {
  SANDBOX
  LIVE
}

/// Roles a user can hold within a Tenant. Authorization never relies on role
/// names alone — permissions are resolved from these roles (see lib/rbac).
enum TenantRole {
  OWNER
  ADMIN
  DEVELOPER
  FINANCE
  VIEWER
}

enum ExpenseCategory {
  INVENTORY
  RENT
  SALARIES
  UTILITIES
  MARKETING
  TRANSPORT
  MAINTENANCE
  TAXES
  SOFTWARE
  OTHER
}

// ---------------------------------------------------------------------------
// Multi-tenancy (infrastructure core)
// ---------------------------------------------------------------------------

/// Tenant = an independent business/customer of the platform (e.g. STOR1).
/// Tenants own Applications; Applications own API keys and (in later phases)
/// payments, ledger accounts, payouts, webhooks, etc. All infrastructure
/// resources are tenant-scoped.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications  Application[]
  members       TenantMember[]
  organizations Organization[]

  @@index([createdAt])
}

/// Membership of a Supabase Auth user in a Tenant. A user may belong to many
/// tenants; authorization checks resolve permissions from this role.
model TenantMember {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(VIEWER)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

/// Application = a product/surface within a Tenant (STOR1 Web, STOR1 Mobile…).
/// Every application implicitly has SANDBOX and LIVE environments; individual
/// records carry the `Environment` enum. An application belongs to exactly
/// one tenant.
model Application {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys         ApiKey[]
  providerConnections ProviderConnection[]
  accounts        Account[]
  journalTransactions JournalTransaction[]
  payments        Payment[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

/// Explicit permission grant for a role. Avoids relying on role names alone.
model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "payments:create", "ledger:read"
  description String?
  createdAt   DateTime @default(now())

  roles Role[]
}

/// Role with explicit permissions. Maps to TenantRole enum but allows
/// granular permission management without enum changes.
model Role {
  id          String       @id @default(cuid())
  name        TenantRole   @unique
  description String?
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

/// API key for an Application in a specific Environment.
/// Public keys (pk_*) are safe to expose; Secret keys (sk_*) and Webhook
/// signing secrets (whsec_*) are stored hashed and only shown once on creation.
model ApiKey {
  id            String      @id @default(cuid())
  applicationId String
  environment   Environment @default(SANDBOX)
  name          String
  keyType       ApiKeyType
  prefix        String      // "pk_test", "sk_live", "whsec" — for identification
  keyHash       String      // bcrypt hash of the secret portion
  keyPreview    String      // Last 4 chars of secret for display (e.g. "sk_live_...abcd")
  scopes        String[]    // Permission names this key grants
  expiresAt     DateTime?
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, environment])
  @@index([keyHash])
}

/// Provider connection (Daraja, etc.) per Application + Environment.
/// Replaces per-Organization MpesaConfig. Secrets encrypted at rest.
model ProviderConnection {
  id            String      @id @default(cuid())
  applicationId String
  environment   Environment @default(SANDBOX)
  provider      String      // "daraja", "sandbox"
  displayName   String      // Human-readable name
  config        Json        // Provider-specific config (shortcode, etc.)
  credentials   Json        // Encrypted secrets (consumerSecret, passkey, etc.)
  enabled       Boolean     @default(false)
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, environment, provider])
  @@index([applicationId])
  @@index([applicationId, environment])
}

enum ApiKeyType {
  PUBLIC
  SECRET
  WEBHOOK_SECRET
}

// ---------------------------------------------------------------------------
// Financial core (double-entry ledger)
// ---------------------------------------------------------------------------

/// Standard account types following double-entry bookkeeping conventions.
/// Assets and expenses carry normal debit balances; liabilities, equity, and
/// revenue carry normal credit balances.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

/// Chart of accounts entry. Each Account belongs to an Application and is
/// scoped to an Environment (SANDBOX or LIVE). Accounts are hierarchical
/// (parent/child) but balances are always computed from the ledger entries
/// — never stored on the Account row itself.
///
/// Invariant: an Account's balance is the sum of all non-voided LedgerEntry
/// rows referencing it, respecting normal balance direction.
model Account {
  id            String      @id @default(cuid())
  applicationId String
  environment   Environment @default(SANDBOX)
  code          String      // Human-readable code, e.g. "1000", "2010"
  name          String      // "Cash on Hand", "M-Pesa Float", "Sales Revenue"
  type          AccountType
  parentId      String?     // For hierarchical chart of accounts
  currency      String      @default("KES")
  active        Boolean     @default(true)
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  parent      Account?     @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[]    @relation("AccountHierarchy")
  entries     LedgerEntry[]

  @@unique([applicationId, environment, code])
  @@index([applicationId])
  @@index([applicationId, environment])
  @@index([applicationId, environment, type])
}

/// A balanced journal entry — the atomic unit of the ledger. Every financial
/// event creates exactly one JournalTransaction with two or more LedgerEntry
/// rows whose debits equal credits.
///
/// Invariants:
///  - sum(debits) == sum(credits) for all non-voided entries
///  - at least two entries per journal transaction
///  - JournalTransaction is never modified after creation (immutable)
model JournalTransaction {
  id            String      @id @default(cuid())
  applicationId String
  environment   Environment @default(SANDBOX)
  reference     String?     // External reference (payment ID, receipt number, etc.)
  description   String      // "Payment from customer", "Refund for order #123"
  postedAt      DateTime    @default(now()) // When the entry was posted
  voidedAt      DateTime?   // Non-null = this entire journal entry is voided
  voidedBy      String?     // Actor who voided
  voidReason    String?     // Reason for voiding
  createdAt     DateTime    @default(now())

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  entries     LedgerEntry[]

  @@index([applicationId])
  @@index([applicationId, environment])
  @@index([applicationId, postedAt])
  @@index([reference])
}

/// A single debit or credit line within a JournalTransaction. LedgerEntry
/// rows are append-only — they are never updated or deleted in normal
/// operation. To reverse an entry, post a new JournalTransaction with
/// opposite debits/credits.
///
/// Invariants:
///  - amountMinor > 0 (entries always carry a positive amount)
///  - type must match Account.type's normal balance:
///    DEBIT entries reduce credit-balance accounts (LIABILITY, EQUITY, REVENUE)
///    CREDIT entries reduce debit-balance accounts (ASSET, EXPENSE)
model LedgerEntry {
  id                   String      @id @default(cuid())
  journalTransactionId String
  accountId            String
  type                 LedgerEntryType
  amountMinor          BigInt      // Amount in minor units (cents), always > 0
  currency             String      @default("KES")
  description          String?
  createdAt            DateTime    @default(now())

  journalTransaction JournalTransaction @relation(fields: [journalTransactionId], references: [id], onDelete: Restrict)
  account            Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalTransactionId])
  @@index([accountId])
  @@index([accountId, createdAt])
  @@index([createdAt])
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

// ---------------------------------------------------------------------------
// Payment domain (provider-agnostic)
// ---------------------------------------------------------------------------

/// Provider-agnostic payment status. Every state transition is recorded
/// in PaymentAttempt; the Payment.status is the current aggregated state.
enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

/// Provider-agnostic payment direction.
enum PaymentDirection {
  INCOMING
  OUTGOING
}

/// A provider-agnostic payment record. Replaces MpesaTransaction as the
/// source of truth for all payment activity. Legacy MpesaTransaction rows
/// are linked via PaymentProviderReference.
///
/// State machine:
///   PENDING → PROCESSING → SUCCEEDED → REFUNDED
///                    ↘ FAILED
///          → CANCELLED
model Payment {
  id            String          @id @default(cuid())
  applicationId String
  environment   Environment     @default(SANDBOX)
  direction     PaymentDirection @default(INCOMING)
  status        PaymentStatus   @default(PENDING)

  // Amount in minor units (cents). KES only initially.
  amountMinor   BigInt
  currency      String          @default("KES")

  // Customer/supplier info
  phone         String?
  email         String?
  customerName  String?

  // Description and references
  description   String?
  idempotencyKey String?        // Client-provided idempotency key
  reference     String?         // External reference (order ID, receipt, etc.)

  // Timestamps
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  processedAt   DateTime?       // When status moved to SUCCEEDED/FAILED/CANCELLED

  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  attempts      PaymentAttempt[]
  providerRefs  PaymentProviderReference[]

  @@unique([applicationId, idempotencyKey])
  @@index([applicationId])
  @@index([applicationId, environment])
  @@index([applicationId, status])
  @@index([applicationId, createdAt])
  @@index([idempotencyKey])
  @@index([status])
}

/// Individual attempt to process a payment through a provider. A single
/// Payment may have multiple attempts (retries, different providers).
/// Each attempt is immutable once created — the state machine append-only.
model PaymentAttempt {
  id                   String   @id @default(cuid())
  paymentId            String
  provider             String   // "daraja", "sandbox"
  status               String   // "PENDING", "ACCEPTED", "REJECTED", "ERROR"
  providerRequestId    String?  // Provider's request ID (e.g. MerchantRequestID)
  providerCheckoutId   String?  // Provider's checkout/session ID (e.g. CheckoutRequestID)
  providerResponse     Json?    // Full provider response (sanitized)
  errorCode            String?  // Provider-specific error code
  errorMessage         String?  // Human-readable error from provider
  amountMinor          BigInt   // Amount attempted
  currency             String   @default("KES")
  createdAt            DateTime @default(now())
  completedAt          DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([providerRequestId])
  @@index([providerCheckoutId])
}

/// Provider-specific correlation IDs for a payment. Links the
/// provider-agnostic Payment to provider-specific records (e.g.
/// MpesaTransaction). Used for reconciliation and debugging.
model PaymentProviderReference {
  id                String   @id @default(cuid())
  paymentId         String
  provider          String   // "daraja", "sandbox"
  externalId        String   // Provider's external ID (e.g. checkoutRequestId)
  externalType      String   // "checkout_request", "merchant_request", "receipt"
  legacyModelId     String?  // FK to legacy model (e.g. MpesaTransaction.id)
  legacyModelName   String?  // "MpesaTransaction"
  createdAt         DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, externalId])
  @@index([paymentId])
  @@index([externalId])
  @@index([legacyModelId])
}

/// Durable idempotency key. Prevents duplicate financial operations when
/// clients retry requests. Each record is scoped to an application +
/// environment and has a TTL.
model IdempotencyRecord {
  id            String      @id @default(cuid())
  applicationId String
  environment   Environment @default(SANDBOX)
  key           String      // The idempotency key provided by the client
  requestHash   String      // Hash of the request body (detects changed payloads)
  responseStatus Int        // HTTP status code to return
  responseBody  Json        // Response body to return
  expiresAt     DateTime    // TTL — clean up old records
  createdAt     DateTime    @default(now())

  @@unique([applicationId, environment, key])
  @@index([applicationId, environment, key])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Multi-tenancy (legacy POS layer — kept for the existing business manager)
// ---------------------------------------------------------------------------

model Organization {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  tier      OrganizationTier @default(FREE)
  businessType String        @default("Retail")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  /// Infrastructure tenant this POS organization belongs to (1:1 during the
  /// transition). Null only for rows created before the tenant backfill.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  members          OrganizationMember[]
  products         Product[]
  customers        Customer[]
  sales            Sale[]
  expenses         Expense[]
  mpesaTransactions MpesaTransaction[]
  mpesaConfig      MpesaConfig?

  @@index([tier])
  @@index([tenantId])
}

// userId references a Supabase Auth user id (or "demo-user" in demo mode).
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole   @default(STAFF)
  firstName      String?
  lastName       String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Product {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  sku                String?
  category           String   @default("General")
  unit               String   @default("pcs") // pcs, kg, ltr, crt, btl...
  costPrice          Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice       Decimal  @default(0) @db.Decimal(12, 2)
  stock              Int      @default(0)
  lowStockThreshold  Int      @default(5)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleItems    SaleItem[]

  @@index([organizationId])
  @@index([organizationId, active])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  location       String?
  notes          String?
  loyaltyPoints  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@index([organizationId])
  @@index([organizationId, phone])
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model Sale {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String?
  receiptNo      String        @unique
  status         SaleStatus    @default(COMPLETED)
  paymentMethod  PaymentMethod @default(MPESA)
  mpesaReference String?
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        SaleItem[]

  @@index([organizationId, createdAt])
  @@index([organizationId, paymentMethod])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String?
  productName  String // denormalized snapshot (product may be renamed/deleted)
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
}

// ---------------------------------------------------------------------------
// M-Pesa transactions
// ---------------------------------------------------------------------------

model MpesaTransaction {
  id             String         @id @default(cuid())
  organizationId String
  direction      MpesaDirection @default(INCOMING)
  phone          String
  accountName    String? // payer/payee name returned by Safaricom
  amount         Decimal        @db.Decimal(12, 2)
  status         MpesaStatus    @default(PENDING)
  reference      String? // e.g. sale receipt number or till/paybill reference
  receiptNo      String? // Safaricom receipt e.g. SFT4X1Q2
  transactionType String        @default("STK_PUSH") // STK_PUSH, C2B, PAYBILL, BUY_GOODS, B2C
  description    String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  // --- Daraja STK Push correlation / callback results -----------------------
  // Returned by Daraja when the STK push is accepted. `checkoutRequestId` is
  // the key the Safaricom callback uses to identify this transaction.
  merchantRequestId String?
  checkoutRequestId String? @unique
  // Populated by the Daraja callback (`stkCallback.ResultCode` / `ResultDesc`).
  resultCode        Int?
  resultDesc        String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([phone])
  @@index([checkoutRequestId])
}

/// Per-organization Safaricom Daraja credentials.
///
/// SECURITY: `consumerSecret` and `passkey` are secrets. They are only ever
/// read inside server-only modules (`src/lib/mpesa/*`, server actions, route
/// handlers) and must never be selected into a payload that reaches the
/// browser. Use `toSafeMpesaConfig()` in `src/lib/mpesa/config.ts` for any
/// value crossing the server/client boundary.
model MpesaConfig {
  id             String           @id @default(cuid())
  organizationId String           @unique
  environment    MpesaEnvironment @default(SANDBOX)
  shortcode      String
  consumerKey    String
  consumerSecret String
  passkey        String
  enabled        Boolean          @default(false)
  /// Optional override for the publicly reachable callback base URL. When
  /// blank the app falls back to MPESA_CALLBACK_BASE_URL / NEXT_PUBLIC_APP_URL.
  callbackUrl    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

model Expense {
  id             String         @id @default(cuid())
  organizationId String
  category       ExpenseCategory @default(OTHER)
  amount         Decimal        @db.Decimal(12, 2)
  description    String
  vendor         String?
  expenseDate    DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expenseDate])
  @@index([organizationId, category])
}
