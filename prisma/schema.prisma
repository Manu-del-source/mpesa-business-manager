// M-Pesa Business Manager — Prisma schema
// PostgreSQL via Supabase. Multi-tenant: every record belongs to an Organization.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationTier {
  FREE
  PRO
}

enum MemberRole {
  OWNER
  ADMIN
  STAFF
}

enum SaleStatus {
  COMPLETED
  PENDING
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  MPESA
  CASH
  CARD
  BANK_TRANSFER
  CREDIT
}

enum MpesaDirection {
  INCOMING
  OUTGOING
}

enum MpesaStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
}

enum ExpenseCategory {
  INVENTORY
  RENT
  SALARIES
  UTILITIES
  MARKETING
  TRANSPORT
  MAINTENANCE
  TAXES
  SOFTWARE
  OTHER
}

// ---------------------------------------------------------------------------
// Multi-tenancy
// ---------------------------------------------------------------------------

model Organization {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  tier      OrganizationTier @default(FREE)
  businessType String        @default("Retail")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members          OrganizationMember[]
  products         Product[]
  customers        Customer[]
  sales            Sale[]
  expenses         Expense[]
  mpesaTransactions MpesaTransaction[]

  @@index([tier])
}

// userId references a Supabase Auth user id (or "demo-user" in demo mode).
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole   @default(STAFF)
  firstName      String?
  lastName       String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Product {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  sku                String?
  category           String   @default("General")
  unit               String   @default("pcs") // pcs, kg, ltr, crt, btl...
  costPrice          Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice       Decimal  @default(0) @db.Decimal(12, 2)
  stock              Int      @default(0)
  lowStockThreshold  Int      @default(5)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleItems    SaleItem[]

  @@index([organizationId])
  @@index([organizationId, active])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  location       String?
  notes          String?
  loyaltyPoints  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@index([organizationId])
  @@index([organizationId, phone])
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model Sale {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String?
  receiptNo      String        @unique
  status         SaleStatus    @default(COMPLETED)
  paymentMethod  PaymentMethod @default(MPESA)
  mpesaReference String?
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        SaleItem[]

  @@index([organizationId, createdAt])
  @@index([organizationId, paymentMethod])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String?
  productName  String // denormalized snapshot (product may be renamed/deleted)
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
}

// ---------------------------------------------------------------------------
// M-Pesa transactions
// ---------------------------------------------------------------------------

model MpesaTransaction {
  id             String         @id @default(cuid())
  organizationId String
  direction      MpesaDirection @default(INCOMING)
  phone          String
  accountName    String? // payer/payee name returned by Safaricom
  amount         Decimal        @db.Decimal(12, 2)
  status         MpesaStatus    @default(PENDING)
  reference      String? // e.g. sale receipt number or till/paybill reference
  receiptNo      String? // Safaricom receipt e.g. SFT4X1Q2
  transactionType String        @default("STK_PUSH") // STK_PUSH, C2B, PAYBILL, BUY_GOODS, B2C
  description    String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([phone])
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

model Expense {
  id             String         @id @default(cuid())
  organizationId String
  category       ExpenseCategory @default(OTHER)
  amount         Decimal        @db.Decimal(12, 2)
  description    String
  vendor         String?
  expenseDate    DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expenseDate])
  @@index([organizationId, category])
}
