# =============================================================================
# M-Pesa Business Manager — environment
# =============================================================================
# Copy to .env and fill in:  cp .env.example .env
#
# .env is gitignored. NEVER commit real credentials.
# Every value below is a PLACEHOLDER — none of them are working credentials.
#
# Legend:  [required]  [required to go live]  [recommended]  [optional]
# =============================================================================

# --- Core --------------------------------------------------------------------

# [required] PostgreSQL connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:5433/mbm?sslmode=disable"

# [required] Public URL of this app. Used as the callback base when
# MPESA_CALLBACK_BASE_URL is not set.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [required] Demo switch.
#   "true"  -> STK push is SIMULATED. No Safaricom credentials needed and no
#              requests are ever sent to Daraja.
#   "false" -> real Daraja requests. Required for any sandbox/production test.
DEMO_MODE="true"

# --- Supabase Auth (skip while DEMO_MODE=true) --------------------------------

# [required to go live] Leave blank in demo mode.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""


# =============================================================================
# M-Pesa / Safaricom Daraja
# =============================================================================
# Per-business Daraja credentials (consumer key, consumer secret, passkey,
# shortcode) are NOT set here. They are entered in the app UI at
#   Settings -> M-Pesa settings   (/settings/mpesa)
# and stored in the MpesaConfig table, scoped per organization.
#
# SECURITY: nothing in this section is a NEXT_PUBLIC_* variable. These values
# are read server-side only and must never be exposed to browser code.
# =============================================================================

# [required to go live] Public HTTPS base URL that Safaricom will POST
# callbacks to. Safaricom CANNOT reach localhost or a private IP, and it
# rejects plain http://. In local development use a tunnel:
#     ngrok http 3000
#     MPESA_CALLBACK_BASE_URL="https://<your-subdomain>.ngrok-free.app"
# Falls back to NEXT_PUBLIC_APP_URL when blank.
# The app derives the full callback URL as:
#     <base>/api/mpesa/callback
MPESA_CALLBACK_BASE_URL=""

# [recommended] Shared secret appended to the callback URL as ?token=...
# Daraja cannot send custom headers, so an unguessable URL plus payload
# validation is the practical way to reject spoofed callbacks.
# Generate with:  openssl rand -hex 32
MPESA_CALLBACK_TOKEN=""

# [required to go live] 32-byte key encrypting Daraja consumer secrets and
# passkeys at rest (AES-256-GCM). Without it they are stored as plaintext.
# Existing plaintext rows keep working and are encrypted next time they save.
# Generate with:  openssl rand -base64 32
MPESA_CREDENTIALS_KEY=""

# [recommended] Shared secret protecting POST /api/mpesa/reconcile, the
# scheduled sweep that settles STK pushes whose callback never arrived.
# The endpoint returns 503 until this is set, so it can never be left
# publicly triggerable by accident.
# Generate with:  openssl rand -hex 32
MPESA_CRON_SECRET=""

# [optional] Milliseconds before a Daraja HTTP request is aborted.
DARAJA_TIMEOUT_MS="20000"


# --- Legacy single-tenant Daraja fallback (optional) --------------------------
# Only used when an organization has NO MpesaConfig row. Prefer the in-app
# per-business configuration above. Placeholders only — never commit real keys.
DARAJA_ENABLED="false"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_PASSKEY=""
DARAJA_SHORTCODE=""
DARAJA_ENVIRONMENT="sandbox"


# --- Testing only -------------------------------------------------------------
# Redirects sandbox Daraja traffic to a local mock (scripts/mock-daraja.mjs)
# for offline development. IGNORED for the production environment so it can
# never redirect real payment traffic.
# MUST be unset for a real Safaricom sandbox test.
DARAJA_BASE_URL_OVERRIDE=""
