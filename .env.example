# ---------------------------------------------------------------------------
# M-Pesa Business Manager — environment configuration
# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required).
# Local docker-compose maps the database to host port 5433:
#   DATABASE_URL="postgres://postgres:postgres@localhost:5433/mbm?sslmode=disable"
# Or point at your Supabase/Neon/RDS Postgres URL.
DATABASE_URL="postgres://postgres:postgres@localhost:5433/mbm?sslmode=disable"

# Public URL of the app (used for auth redirects).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Supabase Auth (OPTIONAL)
# Leave both blank to run in "demo mode" — sign in with any email/password
# and explore with the seeded Kijani Fresh Foods sample data.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# M-Pesa Daraja API (OPTIONAL)
# Leave DARAJA_ENABLED="false" to simulate STK push end-to-end (no credentials
# required). Set to "true" and fill in the rest to go live with Safaricom.
# ---------------------------------------------------------------------------
DARAJA_ENABLED="false"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_PASSKEY=""
DARAJA_SHORTCODE=""
DARAJA_ENVIRONMENT="sandbox" # or "production"
